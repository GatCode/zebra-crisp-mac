#!/bin/bash
# macOS PDF Service. Arguments: title, print options, PDF path.

TITLE="${1:-Label}"
PDF="$3"
FILTER=/Library/Printers/ZebraCrisp/rastertozebracrisp
GENERIC_PPD=/Library/Printers/PPDs/Contents/Resources/ZebraCrisp.ppd

fail() {
  osascript -e 'on run argv' \
            -e 'display alert "Preview Zebra Output" message (item 1 of argv) as warning' \
            -e 'end run' "$1" >/dev/null 2>&1
  exit 1
}

is_crisp() {
  [ -n "$1" ] && grep -qE '^\*NickName: "Zebra (ZPL|EPL2) Label Printer Crisp"' "/etc/cups/ppd/$1.ppd" 2>/dev/null
}

crisp_queue() {
  local queue
  queue="$(lpstat -d 2>/dev/null | sed -n 's/^system default destination: //p')"
  if is_crisp "$queue"; then
    echo "$queue"
    return
  fi
  while read -r queue; do
    if is_crisp "$queue"; then
      echo "$queue"
      return
    fi
  done < <(lpstat -e 2>/dev/null)
}

[ -f "$PDF" ] || fail "The print dialog did not send a document."
[ -x "$FILTER" ] || fail "zebra-crisp-mac is not installed."

queue="$(crisp_queue)"
ppd="$GENERIC_PPD"
cf_args=()
options=()
if [ -n "$queue" ]; then
  ppd="/etc/cups/ppd/$queue.ppd"
  current="$(lpoptions -p "$queue" -l 2>/dev/null)"
  for opt in PageSize Resolution zeCrispLineWeight; do
    value="$(printf '%s\n' "$current" | sed -n "s/^$opt\/[^:]*:.*\*\([^ ]*\).*/\1/p")"
    if [ -n "$value" ]; then
      cf_args+=(-o "$opt=$value")
      options+=("$opt=$value")
    fi
  done
fi

work="$(getconf DARWIN_USER_TEMP_DIR)ZebraCrispPreview"
mkdir -p -m 700 "$work" || fail "Cannot make the preview folder."
find "$work" -type f -mmin +60 -delete
raster="$(mktemp "$work/page.XXXXXX")" || fail "Cannot make the preview folder."
trap 'rm -f "$raster"' EXIT

name="${TITLE//[\/:]/-}"
out="$work/Zebra Preview - ${name:0:200}.pdf"

cupsfilter -p "$ppd" -m application/vnd.cups-raster "${cf_args[@]}" "$PDF" > "$raster" 2>/dev/null
[ -s "$raster" ] || fail "Cannot render the document."

ZEBRA_CRISP_PREVIEW=1 PPD="$ppd" "$FILTER" 1 "$(id -un)" "$TITLE" 1 "${options[*]}" "$raster" > "$out" 2>/dev/null \
  || fail "Cannot make the preview."
open -a Preview "$out"
